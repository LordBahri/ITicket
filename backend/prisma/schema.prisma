generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
  USER
}

enum TicketStatus {
  PENDING_APPROVAL
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum TicketChannel {
  WEB
  EMAIL
  CHAT
  API
  PHONE
  SLACK
  TEAMS
}

enum CompanyType {
  HOLDING
  FILIALE
}

model Company {
  id                  String      @id @default(cuid())
  name                String      @unique
  type                CompanyType @default(FILIALE)
  isActive            Boolean     @default(true)
  isSystemPlaceholder Boolean     @default(false)
  createdAt           DateTime    @default(now())

  // Nom de la base de données Sage 100 de cette société (ex. "Holding" pour Meninx Holding) :
  // sert à générer les noms de fichiers .gcm/.mae lors de l'automatisation d'un accès Sage.
  sageDatabaseName String?

  parentId String?
  parent   Company?  @relation("CompanyHierarchy", fields: [parentId], references: [id])
  children Company[] @relation("CompanyHierarchy")

  users    User[]
  services Service[]
  assets   Asset[]
  licenses License[]

  @@index([parentId])
}

model Service {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  companies Company[]
  users     User[]
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  passwordHash        String
  role                Role     @default(USER)
  isActive            Boolean  @default(true)
  isDepartmentHead    Boolean  @default(false)
  isSystemPlaceholder Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  matricule     String?
  phone         String?
  pcName        String?
  anydeskId     String?
  teamviewerId  String?
  ultraviewerId String?
  avatarUrl     String?

  // Identifiant Active Directory (ex. "MENINX\jdupont") : utilisé pour l'automatisation
  // des accès (RDP, SQL Server) sur les serveurs Sage.
  adUsername String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  managerId String?
  manager   User?   @relation("ManagerHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("ManagerHierarchy")

  ticketsRequested    Ticket[]                @relation("TicketRequester")
  ticketsAssigned     Ticket[]                @relation("TicketAssignee")
  ticketsBeneficiary  Ticket[]                @relation("TicketBeneficiary")
  formArchivedTickets Ticket[]                @relation("TicketFormArchivedBy")
  comments            Comment[]
  attachments         Attachment[]
  articles            KnowledgeArticle[]
  assets              Asset[]
  processApprovals    ProcessApproval[]
  stepCompletionsDone ProcessStepCompletion[]
  chatThread          ChatThread?             @relation("ChatThreadOwner")
  chatMessagesSent    ChatMessage[]           @relation("ChatMessageSender")
  chatReadStates      ChatReadState[]         @relation("ChatReadStateUser")
  ticketStatusChanges TicketStatusHistory[]   @relation("TicketStatusChangedBy")

  @@index([companyId])
  @@index([serviceId])
  @@index([managerId])
}

model TicketType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tickets    Ticket[]
  categories Category[]
  processes  Process[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  tickets       Ticket[]
  articles      KnowledgeArticle[]
  subCategories SubCategory[]
  processes     Process[]

  @@unique([ticketTypeId, name])
  @@index([ticketTypeId])
}

model SubCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  priorityId String
  priority   Priority @relation(fields: [priorityId], references: [id])

  tickets   Ticket[]
  processes Process[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([priorityId])
}

model KnowledgeArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([categoryId])
}

model Priority {
  id                  String   @id @default(cuid())
  name                String   @unique
  level               Int      @default(0)
  color               String   @default("#6b7280")
  responseTimeHours   Int
  resolutionTimeHours Int
  createdAt           DateTime @default(now())

  tickets       Ticket[]
  subCategories SubCategory[]
}

model Ticket {
  id          String        @id @default(cuid())
  reference   String        @unique
  title       String
  description String
  status      TicketStatus  @default(OPEN)
  channel     TicketChannel @default(WEB)

  typeId String
  type   TicketType @relation(fields: [typeId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])

  priorityId String
  priority   Priority @relation(fields: [priorityId], references: [id])

  requesterId String
  requester   User   @relation("TicketRequester", fields: [requesterId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id])

  beneficiaryId String?
  beneficiary   User?   @relation("TicketBeneficiary", fields: [beneficiaryId], references: [id])

  processId String?
  process   Process? @relation(fields: [processId], references: [id])

  physicalFormArchivedAt   DateTime?
  physicalFormArchivedById String?
  physicalFormArchivedBy   User?     @relation("TicketFormArchivedBy", fields: [physicalFormArchivedById], references: [id])

  dueAt      DateTime?
  resolvedAt DateTime?
  closedAt   DateTime?

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments        Comment[]
  attachments     Attachment[]
  approval        ProcessApproval?
  stepCompletions ProcessStepCompletion[]
  statusHistory   TicketStatusHistory[]

  @@index([status])
  @@index([requesterId])
  @@index([assigneeId])
  @@index([beneficiaryId])
  @@index([processId])
  @@index([subCategoryId])
  @@index([isArchived])
}

model TicketStatusHistory {
  id       String       @id @default(cuid())
  ticketId String
  ticket   Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status   TicketStatus

  changedById String?
  changedBy   User?   @relation("TicketStatusChangedBy", fields: [changedById], references: [id])

  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Comment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  message    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

model Attachment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename     String
  url          String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([ticketId])
}

enum AssetStatus {
  EN_SERVICE
  EN_STOCK
  EN_MAINTENANCE
  RETIRE
}

model AssetType {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  assets Asset[]
}

model Asset {
  id              String      @id @default(cuid())
  name            String
  serialNumber    String?     @unique
  model           String?
  status          AssetStatus @default(EN_STOCK)
  purchaseDate    DateTime?
  warrantyEndDate DateTime?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  assetTypeId String
  assetType   AssetType @relation(fields: [assetTypeId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id])

  @@index([assetTypeId])
  @@index([companyId])
  @@index([assigneeId])
}

model License {
  id             String    @id @default(cuid())
  name           String
  vendor         String?
  licenseKey     String?
  seats          Int       @default(1)
  startDate      DateTime?
  expiryDate     DateTime
  notes          String?
  reminder30Sent Boolean   @default(false)
  reminder7Sent  Boolean   @default(false)
  reminder1Sent  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([expiryDate])
}

// --- Processus IT (ITIL : Change Enablement, Request Fulfilment, Access
// Management, Onboarding, Offboarding, Software Asset Management) ---
// Certaines demandes (remplacement de matériel, préparation de poste pour
// un nouvel employé, acquisition de licence...) nécessitent d'entrer dans un
// processus formalisé : réservé aux responsables de service, avec
// validation du supérieur hiérarchique et, pour certains, un formulaire
// papier signé/scanné puis archivé physiquement (traçabilité pour audit).

enum ProcessCategory {
  CHANGE_ENABLEMENT
  REQUEST_FULFILLMENT
  ACCESS_MANAGEMENT
  ASSET_MANAGEMENT
  ONBOARDING
  OFFBOARDING
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Process {
  id                      String          @id @default(cuid())
  name                    String          @unique
  category                ProcessCategory
  description             String?
  requiresManagerApproval Boolean         @default(true)
  requiresPhysicalForm    Boolean         @default(false)
  formTemplateUrl         String?
  isActive                Boolean         @default(true)
  createdAt               DateTime        @default(now())

  // Si vrai, un bouton « Automatiser » apparaît sur les tickets de ce processus pour déclencher
  // l'automatisation de l'accès Sage 100 (RDP + copie des fichiers .gcm/.mae + sécurité SQL Server).
  supportsSageAutomation Boolean @default(false)

  // Type/catégorie/sous-catégorie appliqués automatiquement au ticket créé via ce
  // processus (non modifiables par l'utilisateur) ; ce type de demande n'apparaît
  // donc plus dans le choix "normal" (hors processus) d'un nouveau ticket.
  typeId     String
  ticketType TicketType @relation(fields: [typeId], references: [id])

  categoryId     String
  ticketCategory Category @relation(fields: [categoryId], references: [id])

  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])

  steps   ProcessStep[]
  tickets Ticket[]

  @@index([typeId])
  @@index([categoryId])
  @@index([subCategoryId])
}

model ProcessStep {
  id       String  @id @default(cuid())
  name     String
  order    Int     @default(0)
  isActive Boolean @default(true)

  // Identifie une étape automatisable (ex. "RDP", "FILES", "SQL" pour l'accès Sage) afin que
  // l'automatisation puisse retrouver la bonne étape sans dépendre du libellé ou de l'ordre.
  automationKey String?

  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  completions ProcessStepCompletion[]

  @@index([processId])
}

model ProcessApproval {
  id        String         @id @default(cuid())
  status    ApprovalStatus @default(PENDING)
  comment   String?
  decidedAt DateTime?
  createdAt DateTime       @default(now())

  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  approverId String
  approver   User   @relation(fields: [approverId], references: [id])
}

model ProcessStepCompletion {
  id     String    @id @default(cuid())
  isDone Boolean   @default(false)
  doneAt DateTime?
  note   String?

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  processStepId String
  processStep   ProcessStep @relation(fields: [processStepId], references: [id])

  doneById String?
  doneBy   User?   @relation(fields: [doneById], references: [id])

  @@index([ticketId])
}

// --- Page d'accueil : historique des mises à jour de l'app + actualités IT ---

enum ChangelogType {
  FEATURE
  IMPROVEMENT
  FIX
}

model ChangelogEntry {
  id          String        @id @default(cuid())
  title       String
  description String
  type        ChangelogType @default(FEATURE)
  createdAt   DateTime      @default(now())
}

model NewsArticle {
  id          String    @id @default(cuid())
  title       String
  summary     String?
  imageUrl    String?
  sourceUrl   String    @unique
  sourceName  String
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())

  @@index([publishedAt])
}

// --- Chat interne avec l'équipe support ---

model ChatThread {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation("ChatThreadOwner", fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  messages   ChatMessage[]
  readStates ChatReadState[]
}

model ChatMessage {
  id       String     @id @default(cuid())
  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id])
  senderId String
  sender   User       @relation("ChatMessageSender", fields: [senderId], references: [id])
  body     String?

  attachmentUrl  String?
  attachmentName String?
  attachmentMime String?
  attachmentSize Int?

  createdAt DateTime @default(now())

  @@index([threadId])
}

model ChatReadState {
  id         String     @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id])
  userId     String
  user       User       @relation("ChatReadStateUser", fields: [userId], references: [id])
  lastReadAt DateTime   @default(now())

  @@unique([threadId, userId])
}
