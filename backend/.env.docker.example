# Copiez ce fichier en "backend/.env.docker" (ignoré par git, jamais commité) et remplissez
# les valeurs réelles. docker-compose le charge automatiquement pour le service "backend" ;
# DATABASE_URL, PORT et CORS_ORIGIN restent définis directement dans docker-compose.yml
# (spécifiques à l'environnement Docker) et n'ont pas besoin d'être répétés ici.

# Obligatoire : changez cette valeur, ne gardez jamais la valeur par défaut en production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Envoi des notifications par email (SMTP) — laisser vide pour désactiver (les emails sont
# alors juste logués dans la console du conteneur backend)
# Exemple Office 365 / Outlook (support@meninx.tn) — voir le README pour les prérequis côté
# tenant Microsoft 365 (authentification SMTP/IMAP à activer, mot de passe d'application si MFA)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@meninx.tn
SMTP_PASS=
MAIL_FROM=Support IT Meninx <support@meninx.tn>

# Création de tickets à partir des emails reçus (IMAP) — laisser IMAP_HOST vide pour désactiver
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=support@meninx.tn
IMAP_PASS=
IMAP_POLL_INTERVAL_MS=60000

# Rappel d'expiration des licences
LICENSE_REMINDER_INTERVAL_MS=86400000

# Actualités high-tech sur la page d'accueil (laisser tel quel, ou vide pour désactiver)
NEWS_FEED_URLS=https://www.numerama.com/feed/,https://www.01net.com/actualites/feed/,https://www.presse-citron.net/feed/
NEWS_FEED_INTERVAL_MS=21600000
NEWS_FEED_MAX_ARTICLES=24

# Intégrations optionnelles
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
TEAMS_WEBHOOK_SECRET=
