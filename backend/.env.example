DATABASE_URL="postgresql://iticket:iticket@localhost:5432/iticket"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
# Une ou plusieurs origines autorisées (séparées par des virgules)
CORS_ORIGIN="http://localhost:5173"
# Utilisée pour générer le lien "Voir le ticket" dans les emails
FRONTEND_URL="http://localhost:5173"

# SMTP (facultatif en dev : si absent, les emails sont juste logués en console)
# Exemple Office 365 / Outlook (support@meninx.tn) — voir README pour les prérequis
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="support@meninx.tn"
# SMTP_PASS="<mot de passe ou mot de passe d'application>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="IT Support <support@societe.local>"

# Pièces jointes
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=10

# Ingestion des tickets par email (IMAP) — facultatif : laisser IMAP_HOST vide pour désactiver
# Exemple Office 365 / Outlook (support@meninx.tn) — voir README pour les prérequis
# IMAP_HOST="outlook.office365.com"
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER="support@meninx.tn"
# IMAP_PASS="<mot de passe ou mot de passe d'application>"
IMAP_HOST=""
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=""
IMAP_PASS=""
IMAP_POLL_INTERVAL_MS=60000

# Rappel d'expiration des licences : intervalle de vérification (envoie un email aux ADMIN à J-30/J-7/J-1)
LICENSE_REMINDER_INTERVAL_MS=86400000

# Actualités high-tech sur la page d'accueil : flux RSS séparés par des virgules (laisser tel quel ou vide pour désactiver)
# Pour des alertes de cybersécurité plutôt que de l'actualité générale, remplacez par ex. par les flux du CERT-FR :
# "https://www.cert.ssi.gouv.fr/avis/feed/,https://www.cert.ssi.gouv.fr/alerte/feed/"
NEWS_FEED_URLS="https://www.numerama.com/feed/,https://www.01net.com/actualites/feed/,https://www.presse-citron.net/feed/"
NEWS_FEED_INTERVAL_MS=21600000
NEWS_FEED_MAX_ARTICLES=24

# Intégration Slack (slash command) — laisser vide pour désactiver la vérification de signature
SLACK_SIGNING_SECRET=""
# Bot token Slack (xoxb-...) optionnel, utilisé pour résoudre l'email réel de l'utilisateur via users.info
SLACK_BOT_TOKEN=""

# Intégration Teams (via Power Automate / webhook sortant) — secret partagé attendu dans le header X-Teams-Secret
TEAMS_WEBHOOK_SECRET=""
